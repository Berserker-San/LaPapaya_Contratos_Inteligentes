						"type": "uint256"
					}
				],
				"stateMutability": "view",
				"type": "function"
			}
		],
		"devdoc": {
			"details": "Todos los valores de variables ambientales son enteros escalados ×100      (ej: pH 7.25 → 725, O₂ 4.80 → 480).",
			"errors": {
				"AccessControlBadConfirmation()": [
					{
						"details": "The caller of a function is not the expected one. NOTE: Don't confuse with {AccessControlUnauthorizedAccount}."
					}
				],
				"AccessControlUnauthorizedAccount(address,bytes32)": [
					{
						"details": "The `account` is missing a role."
					}
				]
			},
			"events": {
				"RoleAdminChanged(bytes32,bytes32,bytes32)": {
					"details": "Emitted when `newAdminRole` is set as ``role``'s admin role, replacing `previousAdminRole` `DEFAULT_ADMIN_ROLE` is the starting admin for all roles, despite {RoleAdminChanged} not being emitted to signal this."
				},
				"RoleGranted(bytes32,address,address)": {
					"details": "Emitted when `account` is granted `role`. `sender` is the account that originated the contract call. This account bears the admin role (for the granted role). Expected in cases where the role was granted using the internal {AccessControl-_grantRole}."
				},
				"RoleRevoked(bytes32,address,address)": {
					"details": "Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"
				}
			},
			"kind": "dev",
			"methods": {
				"getRoleAdmin(bytes32)": {
					"details": "Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."
				},
				"getStation(string)": {
					"details": "Retorna campos individuales (no el struct) para compatibilidad con IEnvironmentalMonitoring."
				},
				"grantRole(bytes32,address)": {
					"details": "Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."
				},
				"grantSensorOracle(address)": {
					"params": {
						"account": "Dirección que recibirá el rol."
					}
				},
				"hasRole(bytes32,address)": {
					"details": "Returns `true` if `account` has been granted `role`."
				},
				"isAlertValid(uint256)": {
					"details": "Consumida por FinancialTraceability vía IEnvironmentalMonitoring.",
					"params": {
						"alertId": "ID de la alerta a verificar."
					},
					"returns": {
						"_0": "true si la alerta existe (alertId < alertCount)."
					}
				},
				"recordReading(string,uint256,uint256,uint256,uint256,uint256,uint256,bytes32)": {
					"details": "Compara cada variable contra los umbrales configurados y emite         AlertTriggered por cada variable que supere su rango.",
					"params": {
						"conductivity": "Conductividad escalada ×100.",
						"dissolvedOxygen": "Oxígeno disuelto escalado ×100.",
						"evidenceHash": "Hash de evidencia IPFS u otro sistema externo.",
						"ph": "pH escalado ×100 (ej: 725 = 7.25).",
						"stationId": "Identificador de la estación.",
						"temperature": "Temperatura escalada ×100.",
						"timestamp": "Timestamp Unix de la lectura.",
						"turbidity": "Turbidez escalada ×100."
					}
				},
				"registerStation(string,string,int256,int256)": {
					"params": {
						"latitude": "Latitud escalada ×1e6.",
						"longitude": "Longitud escalada ×1e6.",
						"name": "Nombre descriptivo de la estación.",
						"stationId": "Identificador único de la estación (string)."
					}
				},
				"renounceRole(bytes32,address)": {
					"details": "Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `callerConfirmation`. May emit a {RoleRevoked} event."
				},
				"revokeRole(bytes32,address)": {
					"details": "Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."
				},
				"setThresholds(string,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)": {
					"details": "Todos los valores son enteros escalados ×100. Requiere min < max para cada par."
				},
				"supportsInterface(bytes4)": {
					"details": "Returns true if this contract implements the interface defined by `interfaceId`. See the corresponding https://eips.ethereum.org/EIPS/eip-165#how-interfaces-are-identified[ERC section] to learn more about how these ids are created. This function call must use less than 30 000 gas."
				}
			},
			"title": "EnvironmentalMonitoring",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"ADMIN_ROLE()": {
					"notice": "Rol de administrador — equivale a DEFAULT_ADMIN_ROLE de OpenZeppelin."
				},
				"SENSOR_ORACLE_ROLE()": {
					"notice": "Rol que autoriza el envío de lecturas de sensores."
				},
				"alertCount()": {
					"notice": "Contador global de alertas emitidas (también es el próximo alertId)."
				},
				"alertStation(uint256)": {
					"notice": "Mapea alertId → stationId para que contratos externos validen alertas."
				},
				"constructor": {
					"notice": "Despliega el contrato y asigna DEFAULT_ADMIN_ROLE al deployer."
				},
				"getReadingsCount(string)": {
					"notice": "Retorna el número de lecturas almacenadas para una estación."
				},
				"getStation(string)": {
					"notice": "Retorna los datos de una estación dado su identificador."
				},
				"getThresholds(string)": {
					"notice": "Retorna los umbrales configurados para una estación."
				},
				"grantSensorOracle(address)": {
					"notice": "Otorga el rol SENSOR_ORACLE_ROLE a una dirección."
				},
				"isAlertValid(uint256)": {
					"notice": "Verifica si una alerta existe dado su ID."
				},
				"recordReading(string,uint256,uint256,uint256,uint256,uint256,uint256,bytes32)": {
					"notice": "Registra una lectura de sensor para una estación existente."
				},
				"registerStation(string,string,int256,int256)": {
					"notice": "Registra una nueva estación de monitoreo."
				},
				"setThresholds(string,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)": {
					"notice": "Configura los umbrales de alerta para cada variable ambiental de una estación."
				}
			},
			"notice": "Gestiona estaciones de monitoreo ambiental y lecturas de sensores IoT simulados         para el prototipo \"Río Cali Transparente\".",
			"version": 1
		}
	},
