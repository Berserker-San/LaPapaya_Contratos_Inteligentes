				"requestDisbursement(uint256,uint256,address,string,uint256,uint256)": {
					"details": "Solo el owner puede crear solicitudes.",
					"params": {
						"alertId": "ID de la alerta ambiental validada asociada.",
						"amount": "Monto a desembolsar en unidades de MockCOPToken.",
						"beneficiary": "Dirección receptora de los fondos.",
						"budgetItemId": "ID del rubro de gasto asociado.",
						"justification": "Justificación textual del desembolso.",
						"proposalId": "ID de la propuesta DAO aprobada asociada."
					}
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
