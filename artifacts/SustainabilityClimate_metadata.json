			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"environmentalMonitoring": "Dirección del contrato EnvironmentalMonitoring.        No puede ser address(0)."
					}
				},
				"emitClimateImpactClaim(string,string)": {
					"details": "Requiere que tanto la línea base como el outcome estén registrados y      que el baseline sea mayor que cero.      Fórmula: improvement = ((outcome - baseline) * 100) / baseline      Un valor positivo indica mejora; negativo indica degradación.",
					"params": {
						"stationId": "Identificador de la estación de monitoreo.",
						"variable": "Nombre de la variable ambiental."
					}
				},
				"getRecord(string,string)": {
					"params": {
						"stationId": "Identificador de la estación de monitoreo.",
						"variable": "Nombre de la variable ambiental."
					},
					"returns": {
						"baseline": "      Valor de línea base escalado ×100.",
						"improvementPct": "Porcentaje de mejora (puede ser negativo).",
						"outcome": "       Valor de resultado post-intervención escalado ×100."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"registerBaseline(string,string,uint256)": {
					"params": {
						"stationId": "Identificador de la estación de monitoreo.",
						"value": "Valor escalado ×100 (ej: pH 7.25 → 725).",
						"variable": "Nombre de la variable ambiental (ej: \"dissolvedOxygen\")."
					}
				},
				"registerOutcome(string,string,uint256)": {
					"params": {
						"stationId": "Identificador de la estación de monitoreo.",
						"value": "Valor escalado ×100.",
						"variable": "Nombre de la variable ambiental."
					}
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"title": "SustainabilityClimate",
			"version": 1
		},
		"userdoc": {
			"events": {
				"BaselineRegistered(string,string,uint256)": {
					"notice": "Emitido cuando se registra una línea base."
				},
				"ClimateImpactClaimCreated(string,string,uint256,uint256,int256)": {
					"notice": "Emitido cuando se crea un claim climático con el porcentaje de mejora."
				},
				"OutcomeRegistered(string,string,uint256)": {
					"notice": "Emitido cuando se registra un resultado post-intervención."
				}
			},
			"kind": "user",
			"methods": {
				"emitClimateImpactClaim(string,string)": {
					"notice": "Calcula el porcentaje de mejora y emite un claim climático."
				},
				"getRecord(string,string)": {
					"notice": "Retorna la línea base, el outcome y el porcentaje de mejora calculado         para una estación y variable dados. Casos de retorno:  - Sin baseline ni outcome → (0, 0, 0)  - Solo baseline           → (baselineValue, 0, 0)  - Ambos y baseline > 0    → (baselineValue, outcomeValue, improvementPct)  - Ambos y baseline == 0   → (0, outcomeValue, 0)"
				},
				"records(bytes32)": {
					"notice": "Almacena registros ambientales indexados por         keccak256(abi.encodePacked(stationId, variable))."
				},
				"registerBaseline(string,string,uint256)": {
					"notice": "Registra la línea base ambiental para una estación y variable."
				},
				"registerOutcome(string,string,uint256)": {
					"notice": "Registra el resultado post-intervención para una estación y variable."
				}
			},
			"notice": "Conecta resultados ambientales con indicadores de sostenibilidad y emite         claims climáticos verificables para el prototipo \"Río Cali Transparente\".",
			"version": 1
		}
